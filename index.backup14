/**
 * Otak baru untuk Jurnal. Mengambil data dari server.
 */
async function fetchJurnalPage(page) {
    showSkeletonLoaders('jurnalList');
    document.getElementById('jurnalPagination').innerHTML = '';
    
    currentJurnalPage = page;
    const filterMapel = document.getElementById('filterMapelJurnal').value;
    const searchTerm = document.getElementById('searchJurnalInput').value;

    try {
        const result = await callAppsScript('getJurnalPage', {
            page: page,
            limit: JURNAL_ITEMS_PER_PAGE,
            query: searchTerm,
            filterMapel: filterMapel
        });

        if (result.success) {
            currentJurnalData = result.data;
            renderJurnalList(); // Panggil fungsi render
            renderJurnalPagination(result.paginationInfo.totalPages); // Panggil fungsi paginasi
        } else {
            throw new Error(result.error);
        }
    } catch (error) {
        document.getElementById('jurnalList').innerHTML = `<p class="text-glow-red text-center py-4">Gagal memuat data: ${error.message}</p>`;
    }
}

/**
 * Fungsi ini HANYA me-render HTML untuk Jurnal.
 */
function renderJurnalList() {
    const jurnalList = document.getElementById('jurnalList');
    jurnalList.innerHTML = '';

    const dataToRender = currentJurnalData;

    if (!dataToRender || dataToRender.length === 0) {
        jurnalList.innerHTML = `<p class="text-gray-400 text-center py-4">Tidak ada jurnal yang cocok dengan filter.</p>`;
        return;
    }

    dataToRender.forEach((jurnal, index) => {
        const jurnalCard = document.createElement('div');
        jurnalCard.className = 'neon-canvas py-4 px-3 animate-fade-in';
        // Ini adalah HTML card Jurnal Anda yang lama
        jurnalCard.innerHTML = `
            <div class="flex flex-col">
                <div class="flex justify-between items-start mb-3 space-x-4">
                    <h4 class="flex-1 text-lg font-semibold text-glow break-words">${jurnal.materi}</h4>
                    <span class="flex-shrink-0 px-3 py-1 bg-green-600 text-white text-sm rounded-full">Jam ke-${jurnal.jam}</span>
                </div>
                <div class="flex justify-between items-end pt-3 border-t border-gray-700 space-x-2">
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-sm text-cyan-300">
                        <div><i class="fas fa-calendar mr-2"></i>${formatTanggal(jurnal.tanggal)}</div>
                        <div><i class="fas fa-book mr-2"></i>${jurnal.mapel}</div>
                        <div><i class="fas fa-users mr-2"></i>Kelas ${jurnal.kelas}</div>
                        <div><i class="fas fa-user-check mr-2"></i>Hadir: ${jurnal.hadir}, Tidak: ${jurnal.tidakHadir}</div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button data-timestamp="${jurnal.Timestamp}" class="edit-jurnal-btn icon-button btn-secondary p-2 h-9 w-9 flex items-center justify-center">
                            <i class="fas fa-pencil-alt text-xs"></i>
                            <span class="tooltip-text">Edit</span>
                        </button>
                        <button data-timestamp="${jurnal.Timestamp}" class="delete-jurnal-btn icon-button btn-danger p-2 h-9 w-9 flex items-center justify-center">
                            <i class="fas fa-trash-alt text-xs"></i>
                            <span class="tooltip-text">Hapus</span>
                        </button>
                    </div>
                </div>
                ${jurnal.catatan ? `<div class="text-sm text-gray-400 italic mt-3 border-t border-gray-700 pt-2"><i class="fas fa-sticky-note mr-2"></i>${jurnal.catatan}</div>` : ''}
            </div>
        `;
        jurnalList.appendChild(jurnalCard);
    });
}

/**
 * Fungsi untuk menggambar tombol paginasi Jurnal.
 */
function renderJurnalPagination(totalPages) {
    const paginationContainer = document.getElementById('jurnalPagination');
    paginationContainer.innerHTML = ''; 

    if (totalPages <= 1) return; 

    const prevButton = document.createElement('button');
    prevButton.innerHTML = `<i class="fas fa-chevron-left"></i>`;
    prevButton.className = 'btn-secondary px-4 py-2 rounded-lg';
    prevButton.disabled = (currentJurnalPage === 1);
    prevButton.onclick = () => {
        if (currentJurnalPage > 1) {
            fetchJurnalPage(currentJurnalPage - 1);
        }
    };
    paginationContainer.appendChild(prevButton);

    const pageDisplay = document.createElement('span');
    pageDisplay.className = 'text-glow px-4';
    pageDisplay.textContent = `Halaman ${currentJurnalPage} dari ${totalPages}`;
    paginationContainer.appendChild(pageDisplay);

    const nextButton = document.createElement('button');
    nextButton.innerHTML = `<i class="fas fa-chevron-right"></i>`;
    nextButton.className = 'btn-secondary px-4 py-2 rounded-lg';
    nextButton.disabled = (currentJurnalPage === totalPages);
    nextButton.onclick = () => {
        if (currentJurnalPage < totalPages) {
            fetchJurnalPage(currentJurnalPage + 1);
        }
    };
    paginationContainer.appendChild(nextButton);
}

/**
 * Fungsi untuk membuka/menutup modal Tambah Jurnal.
 */
function openTambahJurnalModal() {
    document.getElementById('jurnalForm').reset();
    try {
        const localDate = new Date();
        const year = localDate.getFullYear();
        const month = String(localDate.getMonth() + 1).padStart(2, '0');
        const day = String(localDate.getDate()).padStart(2, '0');
        document.getElementById('jurnalTanggal').value = `${year}-${month}-${day}`;
    } catch(e) { console.error("Gagal set tanggal: ", e); }

    document.getElementById('tambahJurnalModal').classList.add('show');
}
function closeTambahJurnalModal() {
    document.getElementById('tambahJurnalModal').classList.remove('show');
}

