    if (isOperationInProgress) return showNotification('Harap tunggu operasi sebelumnya selesai.', 'error');

    const submitButton = this.querySelector('button[type="submit"]');
    const siswaData = {
        nama: document.getElementById('namaSiswa').value.trim(),
        kelas: document.getElementById('kelasSiswa').value
    };

    if (!siswaData.nama) return showNotification('Mohon isi nama siswa!', 'error');

    showNotification('Siswa ditambahkan. Menyimpan ke server...', 'success');
    setGlobalLoadingState(true);
    setButtonLoading(submitButton, true);
    
    callAppsScript('addSiswa', siswaData)
        .then(result => {
             if (!result.success) throw new Error(result.error);
             
             showNotification('Siswa berhasil disimpan!', 'success');
             closeTambahSiswaModal(); // <-- TAMBAHKAN BARIS INI UNTUK MENUTUP MODAL

             // Muat ulang data siswa di tabel sesuai filter yang aktif
             return loadDataSiswa(); // Panggil fungsi yang memuat tabel siswa
        })
        .catch(error => {
            showNotification(`Gagal menyimpan: ${error.message}`, 'error');
        })
        .finally(() => {
            setButtonLoading(submitButton, false);
            setGlobalLoadingState(false);
        });
});


// EDIT SISWA.
document.getElementById('editSiswaForm').addEventListener('submit', function(e) {
    e.preventDefault();
    if (isOperationInProgress) return showNotification('Harap tunggu operasi sebelumnya selesai.', 'error');

    const submitButton = this.querySelector('button[type="submit"]');
    const timestamp = document.getElementById('editSiswaTimestamp').value;

    // 1. Ambil data baru
    const updatedData = {
        nama: document.getElementById('editSiswaNama').value,
        kelas: document.getElementById('editSiswaKelas').value,
    };

    // 2. Langsung tutup modal
    closeSiswaEditModal();
    showNotification('Perubahan diterapkan. Menyimpan ke server...', 'success');
    setGlobalLoadingState(true);
    setButtonLoading(submitButton, true);
    
    // --- OPTIMISTIC UPDATE ---
    // 3. Cari data lama
    const index = currentSiswaData.findIndex(item => item.Timestamp === timestamp);
    if (index === -1) {
        loadDataSiswa(); // Fallback
        setGlobalLoadingState(false);
        setButtonLoading(submitButton, false);
        return;
    }

    // 4. Simpan data asli (rollback)
    const backup = { ...currentSiswaData[index] };

    // 5. Perbarui data di array global
    currentSiswaData[index] = { ...backup, ...updatedData };
    
    // 6. RENDER ULANG (INSTAN)
    displaySiswaList(document.getElementById('filterKelas').value);
    // --- END OPTIMISTIC UPDATE ---

    // 7. Kirim ke server
    callAppsScript('updateRow', { sheetName: 'Data_Siswa', timestamp, newRecord: updatedData })
        .then(result => {
            if (!result.success) throw new Error(result.error);
            // SUKSES!
            showNotification('Data siswa berhasil diperbarui!', 'success');
        })
        .catch(error => {
            // GAGAL!
            showNotification(`Gagal update: ${error.message}. Mengembalikan data.`, 'error');
            // 8. ROLLBACK
            currentSiswaData[index] = backup;
            // 9. RENDER ULANG
            displaySiswaList(document.getElementById('filterKelas').value);
        })
        .finally(() => {
            setButtonLoading(submitButton, false);
            setGlobalLoadingState(false);
        });
});


// FUNGSI UNTUK BUKA TUTUP PENILAIAN DAN EDIT
// GANTI FUNGSI LAMA DENGAN VERSI BARU INI
function openPenilaianEditModal(timestamp) {
    // Cari data langsung di 'currentPenilaianData' (yang sudah digrouping server)
    // Bandingkan berdasarkan Timestamp unik grup
    const groupItem = currentPenilaianData.find(group => group.Timestamp === timestamp);

    if (!groupItem) {
        showNotification('Grup data penilaian tidak ditemukan!', 'error');
        return;
    }

    // Isi bagian atas modal (kode ini sama)
    document.getElementById('editPenilaianKeterangan').value = groupItem.keterangan;
    document.getElementById('editPenilaianKelas').value = groupItem.kelas;

    // Siapkan kontainer list siswa (kode ini sama)
    const siswaListContainer = document.getElementById('editPenilaianSiswaList');
    siswaListContainer.innerHTML = '';

    // Buat tabel untuk daftar siswa (kode ini sama)
    const table = document.createElement('table');
    table.className = 'w-full text-left';
    let tableContent = `<tbody>`;

    // Loop melalui 'detailNilai' dari grup yang ditemukan (kode ini sama)
    groupItem.detailNilai.forEach(siswa => {
        // Cari timestamp asli untuk item nilai spesifik ini di data server
        // Ini mungkin perlu penyesuaian tergantung struktur data 'currentPenilaianData'
        // Asumsi server mengembalikan timestamp asli di detailNilai atau kita bisa menemukannya
        // Untuk SEMENTARA, kita gunakan timestamp grup sebagai fallback jika detail tidak ada
        // IDEALNYA: Backend harus menyertakan timestamp asli per siswa di `detailNilai`
        const itemTimestamp = siswa.Timestamp || groupItem.Timestamp; // Fallback jika perlu

        tableContent += `
            <tr class="border-b border-gray-700">
                <td class="py-2 pr-4 text-white">${siswa.nama}</td>
                <td style="width: 120px;">
                    <input type="number" value="${siswa.nilai}" 
                           data-timestamp="${itemTimestamp}" 
                           data-nama="${siswa.nama}" 
                           class="edit-nilai-input w-full neon-input text-center">
                </td>
            </tr>
        `;
    });

    // Selesaikan tabel dan tampilkan modal (kode ini sama)
    tableContent += `</tbody>`;
    table.innerHTML = tableContent;
    siswaListContainer.appendChild(table);
    document.getElementById('editPenilaianModal').classList.remove('hidden');
}

function closeEditPenilaianModal() {
    document.getElementById('editPenilaianModal').classList.add('hidden');
}

// Fungsi untuk Menghapus Item Penilaian
// GANTI (REPLACE) FUNGSI LAMA DENGAN INI
async function deletePenilaianItem(timestamp) {
    if (await showConfirmationModal('yakin ingin menghapusnya?')) { // Tanya konfirmasi
        showNotification('Menghapus grup penilaian...', 'success'); // Tampilkan notif loading

        try {
            // Panggil backend LANGSUNG, kirim timestamp grup
            const result = await callAppsScript('deletePenilaianGroup', {
                timestamp: timestamp
            });
            if (!result.success) throw new Error(result.error); // Cek error

            showNotification('Kegiatan penilaian berhasil dihapus.', 'success'); // Notif sukses
            fetchPenilaianPage(currentPenilaianPage); // Muat ulang halaman saat ini

        } catch (error) {
             showNotification(`Gagal menghapus: ${error.message}`, 'error'); // Notif gagal
             fetchPenilaianPage(currentPenilaianPage); // Muat ulang jika gagal
        }
    }
}


// EDIT PENILAIAN
document.getElementById('editPenilaianForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const submitButton = this.querySelector('button[type="submit"]');
    setButtonLoading(submitButton, true);

    const nilaiInputs = document.querySelectorAll('#editPenilaianSiswaList .edit-nilai-input');
    const updatesArray = [];

    nilaiInputs.forEach(input => {
        updatesArray.push({
            timestamp: input.dataset.timestamp,
            newNilai: parseInt(input.value) || 0,
            namaSiswa: input.dataset.nama // Pastikan nama siswa dikirim
        });
    });

    if (updatesArray.length === 0) {
        showNotification('Tidak ada data untuk disimpan.', 'info');
        closeEditPenilaianModal();
        setButtonLoading(submitButton, false);
        return;
    }

    closeEditPenilaianModal();
    showNotification('Memperbarui nilai...', 'success');

    callAppsScript('updatePenilaianBatch', { updates: updatesArray })
        .then(result => {
            if (!result.success) throw new Error(result.error || 'Server gagal memperbarui data.');
            showNotification('Nilai berhasil diperbarui.', 'success');
            fetchPenilaianPage(currentPenilaianPage); // Muat ulang halaman saat ini
        })
        .catch(error => {
            showNotification(`Gagal sinkronisasi: ${error.message}`, 'error');
            fetchPenilaianPage(currentPenilaianPage); // Muat ulang jika gagal
        })
        .finally(() => {
            setButtonLoading(submitButton, false);
        });
});

// FUNGSI BUKA TUTUP EDIT DAN HAPUS mgmpagenda
function openMgmpAgendaEditModal(timestamp) {
    // PERBAIKAN: Kita bandingkan dalam format ISO string agar konsisten
    const agendaItem = currentMgmpAgendaData.find(item => 
        new Date(item.Timestamp).toISOString() === timestamp
    );

    if (!agendaItem) {
        showNotification('Data agenda MGMP tidak ditemukan!', 'error');
        return;
    }

    // Sisa fungsi ini sudah benar
    document.getElementById('editMgmpAgendaTimestamp').value = agendaItem.Timestamp;
    document.getElementById('editMgmpHari').value = agendaItem.hari;
    document.getElementById('editMgmpTanggal').value = formatTanggal(agendaItem.tanggal);
    document.getElementById('editMgmpWaktu').value = formatWaktu(agendaItem.waktu);
    document.getElementById('editMgmpTempat').value = agendaItem.tempat;
    document.getElementById('editMgmpMateri').value = agendaItem.materi;
    document.getElementById('editMgmpDokumentasi').value = agendaItem.dokumentasi || '';
    
    document.getElementById('editMgmpAgendaModal').classList.remove('hidden');
}

function closeEditMgmpAgendaModal() {
    document.getElementById('editMgmpAgendaModal').classList.add('hidden');
}

