// ========================================================
// ==     FUNGSI-FUNGSI BARU UNTUK MODAL INPUT PENILAIAN ==
// ========================================================

function openInputPenilaianModal() {
    // Ambil detail dari filter untuk judul modal
    const kelas = document.getElementById('kelasPenilaian').value;
    const jenis = document.getElementById('jenisPenilaian').value;
    const ket = document.getElementById('keteranganPenilaian').value;
    document.getElementById('inputNilaiTitle').textContent = `Input Nilai ${jenis} (${ket}) - Kelas ${kelas}`;

    document.getElementById('inputPenilaianModal').classList.add('show');
}
function closeInputPenilaianModal() {
    document.getElementById('inputPenilaianModal').classList.remove('show');
    // Kosongkan tabel di dalam modal saat ditutup
    document.getElementById('penilaianTable').innerHTML = '<tr><td colspan="3" class="py-10 text-center text-gray-400">Pilih kelas, jenis, dan keterangan, lalu klik "Mulai Input Nilai".</td></tr>';
}

