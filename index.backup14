/**
 * Otak baru untuk Penilaian. Mengambil data dari server.
 */
async function fetchPenilaianPage(page) {
    showSkeletonLoaders('daftarPenilaian');
    document.getElementById('penilaianPagination').innerHTML = '';

    currentPenilaianPage = page;
    const searchTerm = document.getElementById('searchPenilaianInput').value;

    try {
        const result = await callAppsScript('getPenilaianPage', {
            page: page,
            limit: PENILAIAN_ITEMS_PER_PAGE,
            query: searchTerm
            // Tidak ada filter search/mapel di sini
        });

        if (result.success) {
            // Data yang diterima sudah digrouping oleh server
            currentPenilaianData = result.data;
            renderPenilaianList(); // Panggil fungsi render
            renderPenilaianPagination(result.paginationInfo.totalPages);
        } else {
            throw new Error(result.error);
        }
    } catch (error) {
        document.getElementById('daftarPenilaian').innerHTML = `<p class="text-glow-red text-center py-4">Gagal memuat data: ${error.message}</p>`;
    }
}

/**
 * Fungsi ini HANYA me-render HTML untuk daftar Penilaian.
 * Menggantikan 'displayPenilaianList'
 */
function renderPenilaianList() {
    const daftarPenilaian = document.getElementById('daftarPenilaian');
    daftarPenilaian.innerHTML = '';

    // currentPenilaianData sekarang berisi data yang sudah digrouping dari server
    const dataToRender = currentPenilaianData;

    if (!dataToRender || dataToRender.length === 0) {
        daftarPenilaian.innerHTML = `<p class="text-gray-400 text-center py-4">Anda belum menginput data penilaian.</p>`;
        return;
    }

    dataToRender.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'neon-canvas py-4 px-3 animate-fade-in';
        // Ini adalah HTML card Anda yang lama
        card.innerHTML = `
            <div class="flex flex-col">
                <div class="flex justify-between items-start mb-3 space-x-4">
                    <h4 class="flex-1 text-lg font-semibold text-glow break-words">${item.keterangan}</h4>
                    <span class="flex-shrink-0 px-3 py-1 bg-purple-600 text-white text-sm rounded-full">${item.jenis}</span>
                </div>
                <div class="flex justify-between items-end pt-3 border-t border-gray-700 space-x-2">
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-sm text-cyan-300">
                        <div><i class="fas fa-calendar mr-2"></i>${formatTanggal(item.tanggal)}</div>
                        <div><i class="fas fa-users mr-2"></i>Kelas ${item.kelas}</div>
                        <div class="sm:col-span-2"><i class="fas fa-user-graduate mr-2"></i>${item.detailNilai.length} siswa dinilai</div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="showPenilaianDetail('${item.Timestamp}')" class="icon-button btn-secondary p-2 h-9 w-9 flex items-center justify-center">
                            <i class="fas fa-eye text-xs"></i>
                            <span class="tooltip-text">Lihat Detail</span>
                        </button>
                        <button onclick="openPenilaianEditModal('${item.Timestamp}')" class="icon-button btn-secondary p-2 h-9 w-9 flex items-center justify-center">
                            <i class="fas fa-pencil-alt text-xs"></i>
                            <span class="tooltip-text">Edit</span>
                        </button>
                        <button onclick="deletePenilaianItem('${item.Timestamp}')" class="icon-button btn-danger p-2 h-9 w-9 flex items-center justify-center">
                            <i class="fas fa-trash-alt text-xs"></i>
                            <span class="tooltip-text">Hapus</span>
                        </button>
                    </div>
                </div>
            </div>
        `;
        daftarPenilaian.appendChild(card);
    });
}

/**
 * Fungsi untuk menggambar tombol paginasi Penilaian.
 */
function renderPenilaianPagination(totalPages) {
    const paginationContainer = document.getElementById('penilaianPagination');
    paginationContainer.innerHTML = '';
    if (totalPages <= 1) return;

    const prevButton = document.createElement('button');
    prevButton.innerHTML = `<i class="fas fa-chevron-left"></i>`;
    prevButton.className = 'btn-secondary px-4 py-2 rounded-lg';
    prevButton.disabled = (currentPenilaianPage === 1);
    prevButton.onclick = () => {
        if (currentPenilaianPage > 1) {
            fetchPenilaianPage(currentPenilaianPage - 1);
        }
    };
    paginationContainer.appendChild(prevButton);

    const pageDisplay = document.createElement('span');
    pageDisplay.className = 'text-glow px-4';
    pageDisplay.textContent = `Halaman ${currentPenilaianPage} dari ${totalPages}`;
    paginationContainer.appendChild(pageDisplay);

    const nextButton = document.createElement('button');
    nextButton.innerHTML = `<i class="fas fa-chevron-right"></i>`;
    nextButton.className = 'btn-secondary px-4 py-2 rounded-lg';
    nextButton.disabled = (currentPenilaianPage === totalPages);
    nextButton.onclick = () => {
        if (currentPenilaianPage < totalPages) {
            fetchPenilaianPage(currentPenilaianPage + 1);
        }
    };
    paginationContainer.appendChild(nextButton);
}
