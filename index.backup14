// --- Bagian Agenda MGMP ---

async function fetchMgmpAgendaPage(page) {
    showSkeletonLoaders('mgmpAgendaList');
    document.getElementById('mgmpAgendaPagination').innerHTML = '';
    
    currentMgmpAgendaPage = page;
    const searchTerm = document.getElementById('searchMgmpAgendaInput').value;

    try {
        const result = await callAppsScript('getMgmpAgendaPage', {
            page: page,
            limit: MGMP_AGENDA_ITEMS_PER_PAGE,
            query: searchTerm
        });

        if (result.success) {
            currentMgmpAgendaData = result.data; // Data dari server (hanya 5 item)
            renderMgmpAgendaList(); 
            renderMgmpAgendaPagination(result.paginationInfo.totalPages);
        } else {
            throw new Error(result.error);
        }
    } catch (error) {
        document.getElementById('mgmpAgendaList').innerHTML = `<p class="text-glow-red text-center py-4">Gagal memuat data: ${error.message}</p>`;
    }
}

function renderMgmpAgendaList() {
    const listContainer = document.getElementById('mgmpAgendaList');
    listContainer.innerHTML = '';

    const dataToRender = currentMgmpAgendaData;

    if (!dataToRender || dataToRender.length === 0) {
        listContainer.innerHTML = `<p class="text-gray-400 text-center py-4">Tidak ada agenda MGMP yang cocok.</p>`;
        return;
    }

    dataToRender.forEach(item => {
        const card = document.createElement('div');
        card.className = 'neon-canvas py-4 px-3 animate-fade-in';
        // Ini adalah HTML card Anda yang lama
        card.innerHTML = `
            <div class="flex flex-col">
                <div class="flex justify-between items-start mb-3">
                    <h4 class="flex-1 text-lg font-semibold text-glow break-words">${item.materi}</h4>
                </div>
                <div class="flex justify-between items-end pt-3 border-t border-gray-700 space-x-2">
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-sm text-cyan-300">
                        <div><i class="fas fa-tag mr-2"></i>${item.hari}</div>
                        <div><i class="fas fa-calendar mr-2"></i>${formatTanggal(item.tanggal)}</div>
                        <div><i class="fas fa-clock mr-2"></i>${formatWaktu(item.waktu)}</div>
                        <div><i class="fas fa-map-marker-alt mr-2"></i>${item.tempat}</div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button data-timestamp="${item.Timestamp}" class="edit-mgmp-btn icon-button btn-secondary p-2 h-9 w-9 flex items-center justify-center">
                            <i class="fas fa-pencil-alt text-xs"></i>
                            <span class="tooltip-text">Edit</span>
                        </button>
                        <button data-timestamp="${item.Timestamp}" class="delete-mgmp-btn icon-button btn-danger p-2 h-9 w-9 flex items-center justify-center">
                            <i class="fas fa-trash-alt text-xs"></i>
                            <span class="tooltip-text">Hapus</span>
                        </button>
                    </div>
                </div>
                ${item.dokumentasi ? `<div class="text-sm text-gray-400 mt-3 border-t border-gray-700 pt-2"><i class="fas fa-link mr-2"></i><a href="${item.dokumentasi}" target="_blank" class="hover:text-glow break-all">${item.dokumentasi}</a></div>` : ''}
            </div>
        `;
        listContainer.appendChild(card);
    });
}

function renderMgmpAgendaPagination(totalPages) {
    const paginationContainer = document.getElementById('mgmpAgendaPagination');
    paginationContainer.innerHTML = ''; 
    if (totalPages <= 1) return; 

    const prevButton = document.createElement('button');
    prevButton.innerHTML = `<i class="fas fa-chevron-left"></i>`;
    prevButton.className = 'btn-secondary px-4 py-2 rounded-lg';
    prevButton.disabled = (currentMgmpAgendaPage === 1);
    prevButton.onclick = () => {
        if (currentMgmpAgendaPage > 1) {
            fetchMgmpAgendaPage(currentMgmpAgendaPage - 1);
        }
    };
    paginationContainer.appendChild(prevButton);

    const pageDisplay = document.createElement('span');
    pageDisplay.className = 'text-glow px-4';
    pageDisplay.textContent = `Halaman ${currentMgmpAgendaPage} dari ${totalPages}`;
    paginationContainer.appendChild(pageDisplay);

    const nextButton = document.createElement('button');
    nextButton.innerHTML = `<i class="fas fa-chevron-right"></i>`;
    nextButton.className = 'btn-secondary px-4 py-2 rounded-lg';
    nextButton.disabled = (currentMgmpAgendaPage === totalPages);
    nextButton.onclick = () => {
        if (currentMgmpAgendaPage < totalPages) {
            fetchMgmpAgendaPage(currentMgmpAgendaPage + 1);
        }
    };
    paginationContainer.appendChild(nextButton);
}

function openTambahMgmpAgendaModal() {
    document.getElementById('mgmpAgendaForm').reset();
    try {
        const localDate = new Date();
        const year = localDate.getFullYear();
        const month = String(localDate.getMonth() + 1).padStart(2, '0');
        const day = String(localDate.getDate()).padStart(2, '0');
        document.getElementById('mgmpTanggal').value = `${year}-${month}-${day}`;
    } catch(e) { console.error("Gagal set tanggal: ", e); }
    document.getElementById('tambahMgmpAgendaModal').classList.add('show');
}
function closeTambahMgmpAgendaModal() {
    document.getElementById('tambahMgmpAgendaModal').classList.remove('show');
}

// --- Bagian Notulen ---

async function fetchNotulenPage(page) {
    showSkeletonLoaders('notulenList');
    document.getElementById('notulenPagination').innerHTML = '';
    
    currentNotulenPage = page;
    const searchTerm = document.getElementById('searchNotulenInput').value;

    try {
        const result = await callAppsScript('getNotulenPage', {
            page: page,
            limit: NOTULEN_ITEMS_PER_PAGE,
            query: searchTerm
        });

        if (result.success) {
            currentMgmpNotulenData = result.data; // Data dari server (hanya 5 item)
            renderNotulenList(); 
            renderNotulenPagination(result.paginationInfo.totalPages);
        } else {
            throw new Error(result.error);
        }
    } catch (error) {
        document.getElementById('notulenList').innerHTML = `<p class="text-glow-red text-center py-4">Gagal memuat data: ${error.message}</p>`;
    }
}

function renderNotulenList() {
    const listContainer = document.getElementById('notulenList');
    listContainer.innerHTML = '';

    const dataToRender = currentMgmpNotulenData;

    if (!dataToRender || dataToRender.length === 0) {
        listContainer.innerHTML = `<p class="text-gray-400 text-center py-4">Tidak ada notulen yang cocok.</p>`;
        return;
    }

    dataToRender.forEach(item => {
        const card = document.createElement('div');
        card.className = 'neon-canvas p-4 animate-fade-in';
        // Ini adalah HTML card Anda yang lama
        card.innerHTML = `
            <div class="flex justify-between items-start mb-2">
                <h4 class="flex-1 text-lg font-semibold text-glow break-words">Notulen Rapat Ke-${item.ke}: ${item.agenda}</h4>
                <span class="text-sm text-gray-400 whitespace-nowrap ml-4">${formatTanggal(item.tanggal)}</span>
            </div>
            <p class="text-sm text-cyan-300 mb-4">Pimpinan: ${item.pimpinan}</p>
            
            <div class="space-y-3 border-t border-gray-700 pt-3">
                <p class="text-sm text-white"><strong class="text-glow">Refleksi:</strong> ${(item.refleksi || '').replace(/\n/g, '<br>')}</p>
                <p class="text-sm text-white"><strong class="text-glow">Tindak Lanjut:</strong> ${(item.tindakLanjut || '').replace(/\n/g, '<br>')}</p>
            </div>

            <div class="flex justify-end items-center space-x-2 mt-4 pt-4 border-t border-gray-700">
                <button data-timestamp="${item.Timestamp}" class="edit-notulen-btn icon-button btn-secondary p-2 h-9 w-9 flex items-center justify-center">
                    <i class="fas fa-pencil-alt text-xs"></i>
                    <span class="tooltip-text">Edit</span>
                </button>
                <button data-timestamp="${item.Timestamp}" class="delete-notulen-btn icon-button btn-danger p-2 h-9 w-9 flex items-center justify-center">
                    <i class="fas fa-trash-alt text-xs"></i>
                    <span class="tooltip-text">Hapus</span>
                </button>
            </div>
        `;
        listContainer.appendChild(card);
    });
}

function renderNotulenPagination(totalPages) {
    const paginationContainer = document.getElementById('notulenPagination');
    paginationContainer.innerHTML = ''; 
