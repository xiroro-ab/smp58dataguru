        // Initialize app
// GANTI BLOK LAMA DENGAN VERSI FINAL INI
document.addEventListener('DOMContentLoaded', function() {
    console.log("DOM Content Loaded: Memulai pengaturan awal...");

    try {
        // =======================================================
        // ==                 PERBAIKAN DI SINI                 ==
        // =======================================================
        // Ambil komponen tanggal LOKAL, bukan UTC
        const localDate = new Date();
        const year = localDate.getFullYear();
        const month = String(localDate.getMonth() + 1).padStart(2, '0'); // +1 karena bulan dimulai dari 0
        const day = String(localDate.getDate()).padStart(2, '0');
        const today = `${year}-${month}-${day}`;
        // =======================================================

        console.log("Tanggal hari ini (LOKAL):", today); 

        const dateInputs = [
            'agendaTanggal', 'jurnalTanggal', 'tanggalAbsen', 
            'tanggalRekapAbsensi', 'mgmpTanggal', 'notulenTanggal'
        ];

        dateInputs.forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                element.value = today;
            }
        });

        // Kode inisialisasi lain
        loadMapelFromStorage();
        populateAllMapelSelects();
        // ===== BLOK LISTENER YANG DIPERBARUI =====
        // Pasang listener untuk search bar dan filter mapel
        const searchAgendaInput = document.getElementById('searchAgendaInput');
        if (searchAgendaInput) {
            // 'keyup' diganti 'change' agar tidak memanggil server di setiap ketukan
            searchAgendaInput.addEventListener('change', () => {
                // Panggil FUNGSI BARU, reset ke halaman 1
                fetchAgendaPage(1); 
            });
        }
        
        const filterMapelAgenda = document.getElementById('filterMapelAgenda');
        if (filterMapelAgenda) {
            filterMapelAgenda.addEventListener('change', () => {
                // Panggil FUNGSI BARU, reset ke halaman 1
                fetchAgendaPage(1);
            });
        }
        // =======================================
        
        // ===== TAMBAHKAN BLOK LISTENER BARU UNTUK JURNAL =====
        const searchJurnalInput = document.getElementById('searchJurnalInput');
        if (searchJurnalInput) {
            searchJurnalInput.addEventListener('change', () => {
                fetchJurnalPage(1); 
            });
        }
        
        const filterMapelJurnal = document.getElementById('filterMapelJurnal');
        if (filterMapelJurnal) {
            filterMapelJurnal.addEventListener('change', () => {
                fetchJurnalPage(1);
            });
        }

        // ===== TAMBAHKAN BLOK LISTENER BARU UNTUK MGMP =====
        const searchMgmpAgendaInput = document.getElementById('searchMgmpAgendaInput');
        if (searchMgmpAgendaInput) {
            searchMgmpAgendaInput.addEventListener('change', () => {
                fetchMgmpAgendaPage(1); 
            });
        }
        
        const searchNotulenInput = document.getElementById('searchNotulenInput');
        if (searchNotulenInput) {
            searchNotulenInput.addEventListener('change', () => {
                fetchNotulenPage(1);
            });
        }

        const searchPenilaianInput = document.getElementById('searchPenilaianInput');
        if (searchPenilaianInput) {
            searchPenilaianInput.addEventListener('change', () => {
                fetchPenilaianPage(1); // Reset ke halaman 1 saat mencari
            });
        }

        document.getElementById('sidebarClose').addEventListener('click', closeSidebar);
        console.log("Pengaturan awal selesai.");

    } catch (error) {
        console.error("💥 ERROR di dalam DOMContentLoaded:", error);
    }
});

