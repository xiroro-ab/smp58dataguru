/**
 * Menonaktifkan atau mengaktifkan semua tombol aksi penting di UI.
 * @param {boolean} isLoading - True untuk menonaktifkan, false untuk mengaktifkan.
 */
function setGlobalLoadingState(isLoading) {
    isOperationInProgress = isLoading;
    // Pilih semua tombol form, tombol edit, dan tombol hapus
    const actionButtons = document.querySelectorAll(
        'form button[type="submit"], .icon-button'
    );
