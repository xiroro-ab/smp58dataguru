// --- EDIT JURNAL ---
document.getElementById('editJurnalForm').addEventListener('submit', function(e) {
    e.preventDefault();
    if (isOperationInProgress) return showNotification('Harap tunggu operasi sebelumnya selesai.', 'error');
    const submitButton = this.querySelector('button[type="submit"]');
    const timestamp = document.getElementById('editJurnalTimestamp').value;

    // 1. Ambil data baru dari form
    const updatedData = {
        tanggal: document.getElementById('editJurnalTanggal').value,
        jam: document.getElementById('editJurnalJam').value,
        mapel: document.getElementById('editJurnalMapel').value,
        kelas: document.getElementById('editJurnalKelas').value,
        materi: document.getElementById('editJurnalMateri').value,
        hadir: document.getElementById('editJurnalHadir').value,
        tidakHadir: document.getElementById('editJurnalTidakHadir').value,
        catatan: document.getElementById('editJurnalCatatan').value
    };

    // 2. Langsung tutup modal
    closeEditJurnalModal();
    showNotification('Jurnal diperbarui. Menyimpan ke server...', 'success');
    setGlobalLoadingState(true);
    setButtonLoading(submitButton, true);

    // --- OPTIMISTIC UPDATE ---
    // 3. Cari data lama
    const index = currentJurnalData.findIndex(item => item.Timestamp === timestamp);
    if (index === -1) {
        fetchJurnalPage(currentJurnalPage); // Fallback
        setGlobalLoadingState(false);
        setButtonLoading(submitButton, false);
        return;
    }
    
    // 4. Simpan data asli (rollback)
    const originalData = { ...currentJurnalData[index] };
    
    // 5. Perbarui data di array global
    currentJurnalData[index] = { ...originalData, ...updatedData };
    
    // 6. RENDER ULANG (INSTAN)
    renderJurnalList();
    // --- END OPTIMISTIC UPDATE ---

    // 7. Kirim ke server
    callAppsScript('updateRow', { sheetName: 'Jurnal_Guru', timestamp, newRecord: updatedData })
        .then(result => {
            if (!result.success) throw new Error(result.error);
            // SUKSES!
            showNotification('Perubahan jurnal berhasil disimpan!', 'success');
        })
        .catch(error => {
            // GAGAL!
            showNotification(`Gagal update: ${error.message}. Mengembalikan data.`, 'error');
            // 8. ROLLBACK
            currentJurnalData[index] = originalData;
            // 9. RENDER ULANG
            renderJurnalList();
        })
        .finally(() => {
            setButtonLoading(submitButton, false);
            setGlobalLoadingState(false);
        });
});

